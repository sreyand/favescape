{
  "name": "favescape",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite apps/web --config apps/web/vite.config.ts",
    "build": "tsc -p apps/web/tsconfig.json && vite build apps/web --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "demo": "python scripts/generate_demo.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
